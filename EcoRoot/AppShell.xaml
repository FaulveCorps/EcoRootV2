<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EcoRoot.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EcoRoot.Views"
    xmlns:resx="clr-namespace:EcoRoot.Resources"
    Title="{x:Static resx:Strings.AppTitle}">

    <TabBar>
        <ShellContent
            Title="{x:Static resx:Strings.HomeTitle}"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage" />
        <ShellContent
            Title="{x:Static resx:Strings.ModulesTitle}"
            ContentTemplate="{DataTemplate views:ModulesPage}"
            Route="ModulesPage" />
        <ShellContent
            Title="{x:Static resx:Strings.TeacherResourcesTitle}"
            ContentTemplate="{DataTemplate views:TeacherResourcesPage}"
            Route="TeacherResourcesPage" />
        <ShellContent
            Title="{x:Static resx:Strings.GlossaryTitle}"
            ContentTemplate="{DataTemplate views:GlossaryPage}"
            Route="GlossaryPage" />
        <ShellContent
            Title="{x:Static resx:Strings.ProgressTitle}"
            ContentTemplate="{DataTemplate views:ProgressPage}"
            Route="ProgressPage" />
    </TabBar>

</Shell>
