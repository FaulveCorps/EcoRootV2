<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:models="clr-namespace:EcoRoot.Models"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.ModuleDetailPage"
             x:Name="RootPage"
             x:DataType="viewmodels:ModuleDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
                 <Label Text="{Binding Module.Title}"
                     Style="{StaticResource TitleLarge}"
                     SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Module.Summary}" Style="{StaticResource BodyMedium}" />

                 <Label Text="{x:Static resx:Strings.LessonsTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                 <Label Text="{x:Static resx:Strings.LessonsEmpty}"
                     Style="{StaticResource BodyMuted}"
                     IsVisible="{Binding IsLessonsEmpty}" />
            <CollectionView ItemsSource="{Binding Lessons}"
                        SelectionMode="None"
                        IsVisible="{Binding HasLessons}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LessonProgressItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding Summary}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" />
                                <Button Text="{x:Static resx:Strings.OpenLesson}"
                                    SemanticProperties.Hint="{x:Static resx:Strings.HintOpenLessonDetails}"
                                        Command="{Binding BindingContext.OpenLessonCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
