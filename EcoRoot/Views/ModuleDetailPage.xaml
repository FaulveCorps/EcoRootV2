<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             xmlns:models="clr-namespace:EcoWay.Models"
             xmlns:resx="clr-namespace:EcoWay.Resources"
             xmlns:views="clr-namespace:EcoWay.Views"
             x:Class="EcoWay.Views.ModuleDetailPage"
             x:Name="RootPage"
             x:DataType="viewmodels:ModuleDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout x:Name="ContentLayout" Padding="24" Spacing="24">
             <VerticalStackLayout Spacing="8">
                 <Label Text="{Binding Module.Title}"
                     Style="{StaticResource TitleLarge}"
                     SemanticProperties.HeadingLevel="Level1" />
                 <Label Text="{Binding Module.Summary}" Style="{StaticResource BodyMedium}" />
             </VerticalStackLayout>

             <Label Text="{x:Static resx:Strings.LessonsTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
             <Label Text="{x:Static resx:Strings.LessonsEmpty}"
                     Style="{StaticResource BodyMuted}"
                     IsVisible="{Binding IsLessonsEmpty}" />
            
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lessons}" Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:LessonProgressItem">
                        <Border Style="{StaticResource AppCard}" Padding="0">
                            <Grid RowDefinitions="Auto, Auto">
                                <BoxView Color="{StaticResource SunYellow}" HeightRequest="4" VerticalOptions="Start"/>
                                <VerticalStackLayout Grid.Row="1" Spacing="8" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="18"/>
                                        <Border BackgroundColor="{StaticResource EcoGreenLight}" StrokeThickness="0" Padding="8,4" VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding TimeEstimate, TargetNullValue='5 min'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource EcoGreenDark}, Dark={StaticResource EcoGreenLight}}" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>
                                    
                                    <Label Text="{Binding Summary}" Style="{StaticResource BodyMedium}" MaxLines="2" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                    
                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                         <Label Text="{Binding StatusText}" Style="{StaticResource BodySmall}" TextColor="{AppThemeBinding Light={StaticResource EcoGreen}, Dark={StaticResource EcoGreenLight}}" FontAttributes="Bold"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                
                                <Button Grid.RowSpan="2"
                                        Text="{x:Static resx:Strings.OpenLesson}"
                                        Opacity="0"
                                        SemanticProperties.Hint="{x:Static resx:Strings.HintOpenLessonDetails}"
                                        CommandParameter="{Binding .}">
                                    <Button.Command>
                                        <Binding Path="OpenLessonCommand"
                                                 Source="{RelativeSource AncestorType={x:Type views:ModuleDetailPage}}"
                                                 x:DataType="views:ModuleDetailPage" />
                                    </Button.Command>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

