<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.QuizPage"
             x:Name="RootPage"
             x:DataType="viewmodels:QuizViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="{Binding LessonTitle}" Style="{StaticResource BodyMuted}" />
                 <Label Text="{x:Static resx:Strings.QuizCheckUnderstandingTitle}"
                   Style="{StaticResource TitleLarge}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Prompt}" Style="{StaticResource BodyMedium}" />

            <CollectionView ItemsSource="{Binding Options}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <Button Text="{Binding .}"
                                    SemanticProperties.Hint="{x:Static resx:Strings.SelectOptionHint}"
                                    Command="{Binding BindingContext.SelectOptionCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

                <Button Text="{x:Static resx:Strings.QuizCheckAnswer}"
                    SemanticProperties.Hint="{x:Static resx:Strings.QuizCheckAnswerHint}"
                    Command="{Binding CheckAnswerCommand}" />

            <Label Text="{Binding Feedback}"
                   IsVisible="{Binding HasFeedback}"
                   Style="{StaticResource BodyMedium}" />

                <Button Text="{Binding NextButtonText}"
                    SemanticProperties.Hint="{x:Static resx:Strings.QuizNextQuestionHint}"
                    Command="{Binding NextQuestionCommand}"
                    Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
