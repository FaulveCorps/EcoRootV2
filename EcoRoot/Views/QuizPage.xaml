<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             xmlns:views="clr-namespace:EcoRoot.Views"
             x:Class="EcoRoot.Views.QuizPage"
             x:Name="RootPage"
             x:DataType="viewmodels:QuizViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView x:Name="MainContent">
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <Label Text="{Binding LessonTitle}" 
                   Style="{StaticResource BodyMuted}" 
                   HorizontalOptions="Center" />

            <Label Text="{x:Static resx:Strings.QuizCheckUnderstandingTitle}"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{StaticResource EcoGreen}"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <!-- Question Card -->
            <Border Style="{StaticResource AppCard}" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="❓" FontSize="40" HorizontalOptions="Center"/>
                    <Label Text="{Binding Prompt}" 
                           Style="{StaticResource BodyLarge}" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <!-- Options -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource AppCard}" BackgroundColor="{StaticResource OffWhite}">
                             <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}">
                                    <TapGestureRecognizer.Command>
                                        <Binding Path="SelectOptionCommand"
                                                 Source="{RelativeSource AncestorType={x:Type views:QuizPage}}"
                                                 x:DataType="views:QuizPage" />
                                    </TapGestureRecognizer.Command>
                                </TapGestureRecognizer>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *" Padding="0">
                                <BoxView WidthRequest="8" Color="{StaticResource SunYellow}" VerticalOptions="Fill" />
                                <Label Text="{Binding .}" 
                                       Style="{StaticResource BodyMedium}" 
                                       Grid.Column="1" 
                                       Padding="16,12"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Feedback Section -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding HasFeedback}">
                <Label Text="{Binding Feedback}"
                       Style="{StaticResource BodyMedium}"
                       TextColor="{StaticResource SoilBrown}"
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Button Text="{x:Static resx:Strings.QuizCheckAnswer}"
                            SemanticProperties.Hint="{x:Static resx:Strings.QuizCheckAnswerHint}"
                            Command="{Binding CheckAnswerCommand}" 
                            Style="{StaticResource PrimaryButton}"
                            Grid.Column="0"/>

                    <Button Text="{Binding NextButtonText}"
                            SemanticProperties.Hint="{x:Static resx:Strings.QuizNextQuestionHint}"
                            Command="{Binding NextQuestionCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Grid.Column="1" />
                </Grid>
            </VerticalStackLayout>
             
             <!-- Action buttons if no feedback yet (initial state) -->
            <Button Text="{x:Static resx:Strings.QuizCheckAnswer}"
                    IsVisible="{Binding IsFeedbackHidden}"
                    SemanticProperties.Hint="{x:Static resx:Strings.QuizCheckAnswerHint}"
                    Command="{Binding CheckAnswerCommand}"
                    Style="{StaticResource PrimaryButton}"
                    VerticalOptions="End" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
