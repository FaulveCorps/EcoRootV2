<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:models="clr-namespace:EcoRoot.Models"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.TeacherResourcesPage"
             x:Name="RootPage"
             x:DataType="viewmodels:TeacherResourcesViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
                 <Label Text="{x:Static resx:Strings.TeacherResourcesTitle}"
                   Style="{StaticResource TitleLarge}"
                   SemanticProperties.HeadingLevel="Level1" />
                 <Label Text="{Binding IntroText}" Style="{StaticResource BodyMedium}" />
                 <Label Text="{Binding StatusMessage}"
                     Style="{StaticResource BodyMuted}"
                     IsVisible="{Binding HasStatusMessage}" />

            <CollectionView ItemsSource="{Binding Resources}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TeacherResourceItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding Description}" Style="{StaticResource BodyMedium}" />
                                <Button Text="{x:Static resx:Strings.TeacherResourcesCopyButton}"
                                        Style="{StaticResource SecondaryButton}"
                                    SemanticProperties.Hint="{x:Static resx:Strings.TeacherResourcesCopyHint}"
                                        Command="{Binding BindingContext.CopyResourceCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
