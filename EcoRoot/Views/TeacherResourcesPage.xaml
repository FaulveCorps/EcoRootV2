<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             xmlns:models="clr-namespace:EcoWay.Models"
             xmlns:resx="clr-namespace:EcoWay.Resources"
             xmlns:views="clr-namespace:EcoWay.Views"
             x:Class="EcoWay.Views.TeacherResourcesPage"
             x:Name="RootPage"
             x:DataType="viewmodels:TeacherResourcesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Sand}, Dark={StaticResource OffBlack}}">

    <ScrollView x:Name="MainContent">
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <VerticalStackLayout Spacing="8">
                <Label Text="{x:Static resx:Strings.TeacherResourcesTitle}"
                       Style="{StaticResource TitleLarge}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding IntroText}" 
                       Style="{StaticResource BodyMedium}" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource HighlightPill}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasStatusMessage}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Resources}" Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TeacherResourceItem">
                        <Border Style="{StaticResource AppCard}">
                            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                    <Label Text="📄" Grid.Column="1" FontSize="20"/>
                                </Grid>
                                
                                <Label Grid.Row="1" Text="{Binding Description}" Style="{StaticResource BodyMedium}" />
                                
                                <Button Grid.Row="2" 
                                        Text="{x:Static resx:Strings.TeacherResourcesCopyButton}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalOptions="Start"
                                        SemanticProperties.Hint="{x:Static resx:Strings.TeacherResourcesCopyHint}"
                                        CommandParameter="{Binding .}">
                                    <Button.Command>
                                        <Binding Path="CopyResourceCommand"
                                                 Source="{RelativeSource AncestorType={x:Type views:TeacherResourcesPage}}"
                                                 x:DataType="views:TeacherResourcesPage" />
                                    </Button.Command>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

