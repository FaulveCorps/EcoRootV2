<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:models="clr-namespace:EcoRoot.Models"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             xmlns:shapes="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:EcoRoot.Views"
             x:Class="EcoRoot.Views.ActivityPage"
             x:Name="RootPage"
             x:DataType="viewmodels:ActivityViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Sand}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout x:Name="ContentLayout" Padding="24" Spacing="24">
            
            <VerticalStackLayout Spacing="8">
                <Label Text="{x:Static resx:Strings.ActivityTitle}"
                       Style="{StaticResource TitleLarge}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{x:Static resx:Strings.ActivitySubtitle}" Style="{StaticResource BodyMedium}" />
            </VerticalStackLayout>

            <!-- Scenario Visualization -->
            <Border Style="{StaticResource AppCard}" HeightRequest="160" Padding="0" Margin="0,8">
                <Grid IsClippedToBounds="True">
                    <!-- Sky Gradient -->
                    <BoxView Color="#E3F2FD" VerticalOptions="Fill" />
                    
                    <!-- Sun -->
                    <Ellipse x:Name="SunVisual" 
                             WidthRequest="60" HeightRequest="60" 
                             Fill="{StaticResource SunYellow}"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="24" />
                    
                    <!-- Ground -->
                    <BoxView x:Name="GroundVisual"
                             Color="{StaticResource EcoGreenLight}" 
                             HeightRequest="60" 
                             VerticalOptions="End" />

                    <!-- Abstract Elements (Trees/Buildings) -->
                    <HorizontalStackLayout x:Name="ElementsVisual" Spacing="16" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,20">
                        <BoxView Color="{StaticResource EcoGreen}" WidthRequest="24" HeightRequest="50" CornerRadius="12,12,0,0" />
                        <BoxView Color="{StaticResource SoilBrown}" WidthRequest="32" HeightRequest="70" CornerRadius="4,4,0,0" />
                        <BoxView Color="{StaticResource EcoGreen}" WidthRequest="28" HeightRequest="40" CornerRadius="14,14,0,0" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource AppCard}" x:Name="ScenarioCard" Padding="20">
                <VerticalStackLayout Spacing="12">
                     <Label Text="🧐" FontSize="32" HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentScenario.Title}" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentScenario.Prompt}" Style="{StaticResource BodyLarge}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="OptionsList" 
                            ItemsSource="{Binding CurrentScenario.Options}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ActivityOption">
                         <Border Style="{StaticResource AppCard}" Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource Gray900}}" StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="3" Opacity="0.1" />
                            </Border.Shadow>
                            <Button Text="{Binding Text}"
                                    Style="{StaticResource ActionButton}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    SemanticProperties.Hint="{x:Static resx:Strings.SelectOptionHint}"
                                    CommandParameter="{Binding .}">
                                <Button.Command>
                                    <Binding Path="SelectOptionCommand"
                                             Source="{RelativeSource AncestorType={x:Type views:ActivityPage}}"
                                             x:DataType="views:ActivityPage" />
                                </Button.Command>
                            </Button>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border x:Name="FeedbackVisual" Style="{StaticResource HighlightPill}" IsVisible="{Binding HasFeedback}" Opacity="0" HorizontalOptions="Center">
                <Label Text="{Binding FeedbackMessage}" Style="{StaticResource BodyBold}" TextColor="{StaticResource SoilBrown}" />
            </Border>

            <Button Text="{x:Static resx:Strings.ActivityNextScenario}"
                    Style="{StaticResource PrimaryButton}"
                    SemanticProperties.Hint="{x:Static resx:Strings.ActivityNextScenarioHint}"
                    Command="{Binding NextScenarioCommand}"
                    Margin="0,24,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
