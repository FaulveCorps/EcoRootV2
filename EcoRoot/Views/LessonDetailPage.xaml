<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             xmlns:models="clr-namespace:EcoWay.Models"
             xmlns:resx="clr-namespace:EcoWay.Resources"
             x:Class="EcoWay.Views.LessonDetailPage"
             x:DataType="viewmodels:LessonDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout x:Name="ContentLayout" Padding="24" Spacing="20" Opacity="0">
            <Label Text="{Binding ModuleTitle}" Style="{StaticResource BodyMuted}" TextTransform="Uppercase" CharacterSpacing="1"/>
            <Label Text="{Binding Lesson.Title}"
                   Style="{StaticResource TitleLarge}"
                   SemanticProperties.HeadingLevel="Level1" />
            
            <Border BackgroundColor="{StaticResource EcoGreenLight}" StrokeThickness="0" Padding="12">
                 <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                 </Border.StrokeShape>
                 <Label Text="{Binding Lesson.Summary}" Style="{StaticResource BodyMedium}" />
            </Border>

            <HorizontalStackLayout Spacing="8">
                <Border Style="{StaticResource AppPill}" BackgroundColor="{StaticResource SunYellowLight}" Stroke="{StaticResource SunYellow}" StrokeThickness="0">
                    <Label Text="{Binding TimeEstimate, TargetNullValue='5 min read'}" Style="{StaticResource BodySmall}" TextColor="{AppThemeBinding Light={StaticResource SoilBrown}, Dark={StaticResource SunYellowLight}}" FontAttributes="Bold"/>
                </Border>
                <Border Style="{StaticResource AppPill}" BackgroundColor="{StaticResource Gray100}" StrokeThickness="0">
                    <Label Text="{Binding CompletionStatus}" Style="{StaticResource BodySmall}" />
                </Border>
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

            <!-- Replaced CollectionView with BindableLayout for better desktop scrolling compatibility -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:LessonSection">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Heading}" Style="{StaticResource SectionHeader}" TextColor="{AppThemeBinding Light={StaticResource EcoGreenDark}, Dark={StaticResource EcoGreenLight}}"/>
                            <Label Text="{Binding Body}" Style="{StaticResource BodyLarge}" LineHeight="1.5" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{x:Static resx:Strings.QuizCheckUnderstandingTitle}"
                    IsEnabled="{Binding HasQuiz}"
                    Style="{StaticResource PrimaryButton}"
                    SemanticProperties.Hint="{x:Static resx:Strings.HintStartQuiz}"
                    Command="{Binding StartQuizCommand}"
                    Margin="0,24,0,48"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

