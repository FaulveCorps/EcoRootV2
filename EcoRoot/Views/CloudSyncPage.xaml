<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             xmlns:resx="clr-namespace:EcoWay.Resources"
             x:Class="EcoWay.Views.CloudSyncPage"
             x:DataType="viewmodels:CloudSyncViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Sand}, Dark={StaticResource OffBlack}}">

    <ScrollView x:Name="MainContent">
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="{x:Static resx:Strings.CloudSyncTitle}"
                           Style="{StaticResource TitleLarge}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="☁️" Grid.Column="1" FontSize="32" VerticalOptions="Start"/>
                </Grid>
                <Label Text="{Binding IntroText}" Style="{StaticResource BodyMedium}" />
            </VerticalStackLayout>

            <!-- Status Card -->
            <Border Style="{StaticResource AppCard}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{x:Static resx:Strings.CloudSyncStatusTitle}" Style="{StaticResource CardTitle}" />
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource BodyMedium}" VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding IsSyncEnabled}" 
                                OnColor="{StaticResource EcoGreen}"
                                Grid.Column="1"
                                SemanticProperties.Hint="{x:Static resx:Strings.CloudSyncToggleHint}" />
                    </Grid>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Sand}" Opacity="0.5"/>
                    
                    <Label Text="{x:Static resx:Strings.CloudSyncLastSyncTitle}" Style="{StaticResource BodySmall}" TextColor="{AppThemeBinding Light={StaticResource TextColorMuted}, Dark={StaticResource TextColorMutedDark}}"/>
                    <Label Text="{Binding LastSyncText}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Data Card -->
            <Border Style="{StaticResource AppCard}">
                <VerticalStackLayout Spacing="12">
                     <Label Text="{Binding DataTitle}" Style="{StaticResource CardTitle}" />
                    <CollectionView ItemsSource="{Binding DataItems}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding ., StringFormat='• {0}'}" Style="{StaticResource BodyMedium}" Margin="8,4" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Consent Warning -->
            <Border Style="{StaticResource AppCard}" BackgroundColor="{StaticResource SunYellowLight}" StrokeThickness="0" IsVisible="{Binding IsConsentRequired}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="⚠️" FontSize="20" Margin="0,0,10,0" />
                        <Label Text="{x:Static resx:Strings.CloudSyncConsentRequired}" Style="{StaticResource BodyBold}" Grid.Column="1" TextColor="{AppThemeBinding Light={StaticResource SoilBrown}, Dark={StaticResource SunYellowLight}}"/>
                    </Grid>
                    <Button Text="{x:Static resx:Strings.CloudSyncProvideConsent}"
                            Style="{StaticResource PrimaryButton}"
                            SemanticProperties.Hint="{x:Static resx:Strings.CloudSyncConsentHint}"
                            Command="{Binding ProvideConsentCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

