<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.GlossaryPage"
             x:DataType="viewmodels:GlossaryViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Sand}, Dark={StaticResource OffBlack}}">

    <ScrollView x:Name="MainContent">
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <VerticalStackLayout Spacing="8">
                 <Label Text="{x:Static resx:Strings.GlossaryTitle}"
                     Style="{StaticResource TitleLarge}"
                     SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding IntroText}" Style="{StaticResource BodyMedium}" />
            </VerticalStackLayout>

             <Label Text="{x:Static resx:Strings.GlossaryEmpty}"
                 Style="{StaticResource BodyMuted}"
                 HorizontalOptions="Center"
                 IsVisible="{Binding IsTermsEmpty}" />

            <CollectionView ItemsSource="{Binding Terms}"
                    SelectionMode="None"
                    IsVisible="{Binding HasTerms}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource AppCard}" Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Text="📖" FontSize="20" Margin="0,0,12,0" VerticalOptions="Start"/>
                                <Label Text="{Binding .}" Style="{StaticResource BodyMedium}" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
