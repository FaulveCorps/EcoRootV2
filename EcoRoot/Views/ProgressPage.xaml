<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:models="clr-namespace:EcoRoot.Models"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.ProgressPage"
             x:DataType="viewmodels:ProgressViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Sand}, Dark={StaticResource OffBlack}}">

    <ScrollView x:Name="MainContent">
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding Headline}"
                       Style="{StaticResource TitleLarge}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Body}" 
                       Style="{StaticResource BodyMedium}" />
            </VerticalStackLayout>

            <!-- Module Progress Section -->
            <Label Text="{x:Static resx:Strings.ProgressStatsTitle}" 
                   Style="{StaticResource SectionHeader}" />
                   
            <CollectionView ItemsSource="{Binding ModuleProgress}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ModuleProgressItem">
                        <Border Style="{StaticResource AppCard}" Margin="0,0,0,16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding Summary}" Style="{StaticResource BodyMuted}" LineBreakMode="TailTruncation" />
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                     <!-- Mocking a custom bar using visual elements for cleaner look than standard ProgressBar -->
                                    <Border StrokeThickness="0" HeightRequest="8" BackgroundColor="{StaticResource EcoGreenLight}" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                         <!-- Because we lack a converter right now for width, revert to standard ProgressBar for safety but styled -->
                                         <ProgressBar Progress="{Binding CompletionRatio}" ProgressColor="{StaticResource EcoGreen}" ScaleY="4" BackgroundColor="Transparent" />
                                    </Border>
                                    
                                    <Label Text="{Binding CompletionRatio, StringFormat='{0:P0}'}" 
                                           Style="{StaticResource BodySmall}"
                                           TextColor="{StaticResource EcoGreen}"
                                           FontAttributes="Bold"
                                           Grid.Column="1"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Badges Section -->
            <Label Text="{x:Static resx:Strings.ProgressBadgesTitle}" Style="{StaticResource SectionHeader}" />
            <CollectionView ItemsSource="{Binding Badges}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BadgeItem">
                        <Border Style="{StaticResource AppCard}" BackgroundColor="{StaticResource SunYellowLight}">
                            <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="🏆" HorizontalOptions="Center" FontSize="32"/>
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding StatusText}" Style="{StaticResource BodySmall}" HorizontalOptions="Center" TextColor="{StaticResource SoilBrown}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Quiz Attempts Section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{x:Static resx:Strings.ProgressQuizAttemptsTitle}" Style="{StaticResource SectionHeader}" />
                <Label Text="{Binding QuizSummaryText}" Style="{StaticResource BodyMuted}" />
                
                <Label Text="{x:Static resx:Strings.ProgressQuizEmpty}"
                       Style="{StaticResource BodyMuted}"
                       IsVisible="{Binding IsQuizAttemptsEmpty}" />

                <CollectionView ItemsSource="{Binding RecentQuizAttempts}"
                                SelectionMode="None"
                                IsVisible="{Binding HasQuizAttempts}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QuizAttemptItem">
                            <Border Style="{StaticResource AppCard}" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    <Label Text="{Binding LessonTitle}" Style="{StaticResource BodyBold}" Grid.Column="0" />
                                    <Label Text="{Binding ScoreText}" Style="{StaticResource HighlightPill}" HorizontalOptions="End" Grid.Column="1" />
                                    <Label Text="{Binding AttemptedAtText}" Style="{StaticResource BodySmall}" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Cloud Sync Section -->
            <Border Style="{StaticResource AppCard}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                         <Label Text="{x:Static resx:Strings.CloudSyncCardTitle}" Style="{StaticResource CardTitle}" VerticalOptions="Center"/>
                         <Label Text="☁️" FontSize="24" HorizontalOptions="End" Grid.Column="1"/>
                    </Grid>
                    <Label Text="{x:Static resx:Strings.CloudSyncCardBody}" Style="{StaticResource BodyMedium}" />
                    <Button Text="{x:Static resx:Strings.CloudSyncOpenAction}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenCloudSyncCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
