<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:models="clr-namespace:EcoRoot.Models"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.ProgressPage"
             x:DataType="viewmodels:ProgressViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
                 <Label Text="{Binding Headline}"
                     Style="{StaticResource TitleLarge}"
                     SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Body}" Style="{StaticResource BodyMedium}" />

            <CollectionView ItemsSource="{Binding ModuleProgress}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ModuleProgressItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding Summary}" Style="{StaticResource BodyMuted}" />
                                <ProgressBar Progress="{Binding CompletionRatio}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:Strings.CloudSyncCardTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{x:Static resx:Strings.CloudSyncCardBody}" Style="{StaticResource BodyMedium}" />
                    <Button Text="{x:Static resx:Strings.CloudSyncOpenAction}"
                            Style="{StaticResource SecondaryButton}"
                            SemanticProperties.Hint="{x:Static resx:Strings.CloudSyncHint}"
                            Command="{Binding OpenCloudSyncCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static resx:Strings.ProgressBadgesTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <CollectionView ItemsSource="{Binding Badges}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BadgeItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding Description}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

                 <Label Text="{x:Static resx:Strings.ProgressQuizAttemptsTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding QuizSummaryText}" Style="{StaticResource BodyMuted}" />
                 <Label Text="{x:Static resx:Strings.ProgressQuizEmpty}"
                     Style="{StaticResource BodyMuted}"
                     IsVisible="{Binding IsQuizAttemptsEmpty}" />

            <CollectionView ItemsSource="{Binding RecentQuizAttempts}"
                        SelectionMode="None"
                        IsVisible="{Binding HasQuizAttempts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:QuizAttemptItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding LessonTitle}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding ScoreText}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding AttemptedAtText}" Style="{StaticResource BodyMuted}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
