<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:models="clr-namespace:EcoRoot.Models"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.ModulesPage"
             x:Name="RootPage"
             x:DataType="viewmodels:ModulesViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
                 <Label Text="{x:Static resx:Strings.ModulesHeading}"
                     Style="{StaticResource TitleLarge}"
                     SemanticProperties.HeadingLevel="Level1" />
              <Label Text="{x:Static resx:Strings.ModulesSubtitle}" Style="{StaticResource BodyMedium}" />

                 <Label Text="{x:Static resx:Strings.ModulesEmpty}"
                     Style="{StaticResource BodyMuted}"
                     IsVisible="{Binding IsModulesEmpty}" />

            <CollectionView ItemsSource="{Binding Modules}"
                        SelectionMode="None"
                        IsVisible="{Binding HasModules}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ModuleListItem">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding Summary}" Style="{StaticResource BodyMedium}" />
                                <Label Text="{Binding ProgressSummary}" Style="{StaticResource BodyMuted}" />
                                <ProgressBar Progress="{Binding CompletionRatio}" />
                                <Button Text="{x:Static resx:Strings.ModulesViewLessons}"
                                    SemanticProperties.Hint="{x:Static resx:Strings.HintOpenModuleLessons}"
                                        Command="{Binding BindingContext.OpenModuleCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
