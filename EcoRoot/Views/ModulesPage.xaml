<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:models="clr-namespace:EcoRoot.Models"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             xmlns:views="clr-namespace:EcoRoot.Views"
             x:Class="EcoRoot.Views.ModulesPage"
             x:Name="RootPage"
             x:DataType="viewmodels:ModulesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout x:Name="MainContent" Padding="24" Spacing="24" Opacity="0">
             
             <VerticalStackLayout Spacing="8">
                 <Label Text="{x:Static resx:Strings.ModulesHeading}"
                     Style="{StaticResource TitleLarge}"
                     SemanticProperties.HeadingLevel="Level1" />
                  <Label Text="{x:Static resx:Strings.ModulesSubtitle}" Style="{StaticResource BodyMedium}" />
             </VerticalStackLayout>

             <Label Text="{x:Static resx:Strings.ModulesEmpty}"
                 Style="{StaticResource BodyMuted}"
                 IsVisible="{Binding IsModulesEmpty}" />

            <CollectionView ItemsSource="{Binding Modules}"
                        SelectionMode="None"
                        IsVisible="{Binding HasModules}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ModuleListItem">
                        <Border Style="{StaticResource AppCard}" Margin="0,0,0,16" Padding="0">
                            <Grid RowDefinitions="Auto, Auto, Auto">
                                <!-- Banner / Header Color Strip -->
                                <BoxView Color="{StaticResource EcoGreenLight}" HeightRequest="6" VerticalOptions="Start" />
                                
                                <VerticalStackLayout Spacing="12" Padding="16" Grid.Row="1">
                                    <Grid ColumnDefinitions="*, Auto">
                                         <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="18" LineBreakMode="WordWrap"/>
                                         <Border BackgroundColor="{StaticResource SunYellowLight}" StrokeThickness="0" Padding="8,4" Grid.Column="1" VerticalOptions="Start">
                                             <Border.StrokeShape>
                                                 <RoundRectangle CornerRadius="8"/>
                                             </Border.StrokeShape>
                                             <Label Text="Start" FontSize="12" TextColor="{StaticResource SoilBrown}" FontAttributes="Bold"/>
                                         </Border>
                                    </Grid>
                                    
                                    <Label Text="{Binding Summary}" Style="{StaticResource BodyMedium}" LineBreakMode="TailTruncation" MaxLines="2" TextColor="{StaticResource Gray600}"/>
                                    
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" Margin="0,4,0,0">
                                        <Border StrokeThickness="0" HeightRequest="8" BackgroundColor="{StaticResource Gray100}" VerticalOptions="Center">
                                             <Border.StrokeShape>
                                                 <RoundRectangle CornerRadius="4"/>
                                             </Border.StrokeShape>
                                             <ProgressBar Progress="{Binding CompletionRatio}" ProgressColor="{StaticResource EcoGreen}"/>
                                        </Border>
                                        <Label Text="{Binding CompletionRatio, StringFormat='{0:P0}'}" 
                                               Grid.Column="1" 
                                               Style="{StaticResource BodySmall}"
                                               TextColor="{StaticResource EcoGreen}"
                                               FontAttributes="Bold"/>
                                    </Grid>
                                    
                                    <Label Text="{Binding ProgressSummary}" Style="{StaticResource BodySmall}" TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                                
                                <Button Text="{x:Static resx:Strings.ModulesViewLessons}"
                                        Grid.Row="1"
                                        Opacity="0"
                                        Style="{StaticResource ActionButton}"
                                        SemanticProperties.Hint="{x:Static resx:Strings.HintOpenModuleLessons}"
                                        CommandParameter="{Binding .}">
                                    <Button.Command>
                                        <Binding Path="OpenModuleCommand"
                                                 Source="{RelativeSource AncestorType={x:Type views:ModulesPage}}"
                                                 x:DataType="views:ModulesPage" />
                                    </Button.Command>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
