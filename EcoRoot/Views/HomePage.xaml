<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             x:Class="EcoRoot.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Headline}"
                       Style="{StaticResource TitleLarge}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource BodyMedium}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:Strings.HomeProgressTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding ProgressSummary}" Style="{StaticResource BodyMuted}" />
                    <ProgressBar Progress="{Binding ProgressRatio}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static resx:Strings.HomeFocusTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding FocusDescription}" Style="{StaticResource BodyMedium}" />
                    <Button Text="{Binding PrimaryActionText}"
                            SemanticProperties.Hint="{x:Static resx:Strings.HintOpenFoundations}"
                            Command="{Binding PrimaryActionCommand}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static resx:Strings.HomePillarsTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                <CollectionView ItemsSource="{Binding LearningPillars}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PillBorder}" Margin="0,0,0,8">
                                <Label Text="{Binding .}" Style="{StaticResource BodyMedium}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:Strings.HomeTeacherCornerTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{x:Static resx:Strings.HomeTeacherCornerBody}" Style="{StaticResource BodyMedium}" />
                    <Button Text="{Binding TeacherResourcesText}"
                            Style="{StaticResource SecondaryButton}"
                            SemanticProperties.Hint="{x:Static resx:Strings.HintOpenTeacherResources}"
                            Command="{Binding TeacherResourcesCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:Strings.ActivityTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{x:Static resx:Strings.ActivitySubtitle}" Style="{StaticResource BodyMedium}" />
                    <Button Text="{Binding ActivityText}"
                            Style="{StaticResource SecondaryButton}"
                            SemanticProperties.Hint="{x:Static resx:Strings.ActivityHint}"
                            Command="{Binding ActivityCommand}" />
                </VerticalStackLayout>
            </Border>

                <Button Text="{Binding SecondaryActionText}"
                    Style="{StaticResource SecondaryButton}"
                        SemanticProperties.Hint="{x:Static resx:Strings.HintOpenGlossary}"
                    Command="{Binding SecondaryActionCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
