<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoRoot.ViewModels"
             xmlns:resx="clr-namespace:EcoRoot.Resources"
             xmlns:controls="clr-namespace:EcoRoot.Controls"
             x:Class="EcoRoot.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Sand}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout x:Name="MainContent" Spacing="0">
            <!-- Hero Section -->
            <Grid Padding="24,40,24,60" RowDefinitions="Auto,Auto">
                <Grid.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="#2E7D32" Offset="0.1"/>
                        <GradientStop Color="#1B5E20" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                
                <!-- Background Decoration -->
                <Path Data="{StaticResource IconLeaf}" Fill="White" Opacity="0.1" Scale="10" TranslationX="100" TranslationY="0" InputTransparent="True" />

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Headline}"
                           TextColor="White"
                           FontSize="32"
                           FontAttributes="Bold"
                           HorizontalOptions="Start" />
                    <Label Text="{Binding Subtitle}" 
                           TextColor="#E8F5E9"
                           FontSize="18" />
                </VerticalStackLayout>
            </Grid>

            <!-- Main Cards Content (Overlapping Hero) -->
            <VerticalStackLayout Spacing="24" Padding="24" Margin="0,-40,0,0">
                
                <!-- Progress Card (New Visualization) -->
                <Border Style="{StaticResource AppCard}" StrokeThickness="0">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{x:Static resx:Strings.HomeProgressTitle}" Style="{StaticResource CardTitle}" FontSize="18"/>
                             <Label Text="{Binding ProgressSummary}" Style="{StaticResource BodyMedium}" />
                            <Button Text="Continue" 
                                    Style="{StaticResource SecondaryButton}" 
                                    HorizontalOptions="Start" 
                                    HeightRequest="40" 
                                    FontSize="14" 
                                    Margin="0,8,0,0"
                                    Command="{Binding PrimaryActionCommand}"/>
                        </VerticalStackLayout>
                        
                        <!-- Circular Progress -->
                        <controls:CircularProgressBar Grid.Column="1" ProgressRatio="{Binding ProgressRatio}" HorizontalOptions="End"/>
                    </Grid>
                </Border>

                <!-- Next Lesson Focus -->
                <Border Style="{StaticResource AppCard}" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{x:Static resx:Strings.HomeFocusTitle}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding FocusDescription}" Style="{StaticResource BodyLarge}" />
                        
                        <!-- Sleek Pill Actions -->
                        <HorizontalStackLayout Spacing="10">
                            <Border Style="{StaticResource AppPill}" BackgroundColor="{StaticResource EcoGreenLight}" StrokeThickness="0">
                                <HorizontalStackLayout Spacing="4">
                                     <Path Data="{StaticResource IconLeaf}" Fill="{StaticResource EcoGreen}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                                     <Label Text="Foundations" TextColor="{StaticResource EcoGreenDark}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                             <Border Style="{StaticResource AppPill}" BackgroundColor="{StaticResource SunYellowLight}" StrokeThickness="0">
                                <HorizontalStackLayout Spacing="4">
                                     <Path Data="{StaticResource IconPuzzle}" Fill="{StaticResource SoilBrown}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center"/>
                                     <Label Text="Quiz Available" TextColor="{StaticResource SoilBrown}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                        
                    </VerticalStackLayout>
                </Border>

                <!-- Pillars Carousel -->
                <Label Text="{x:Static resx:Strings.HomePillarsTitle}" Style="{StaticResource SectionHeader}" Margin="4,0" />
                
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="160" Margin="-24,0">
                    <HorizontalStackLayout Spacing="16" Padding="24,10">
                        <!-- Knowledge -->
                        <Border Style="{StaticResource AppCard}" WidthRequest="130" HeightRequest="150" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" Padding="16">
                             <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                                <Border BackgroundColor="{StaticResource EcoGreenLight}" StrokeShape="RoundRectangle 25" HeightRequest="50" WidthRequest="50" Padding="12">
                                     <Path Data="{StaticResource IconLeaf}" Fill="{StaticResource EcoGreen}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Knowledge" Style="{StaticResource BodyBold}" 
                                       VerticalOptions="Center" 
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource EcoGreenDark}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Action -->
                        <Border Style="{StaticResource AppCard}" WidthRequest="130" HeightRequest="150" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" Padding="16">
                             <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                                 <Border BackgroundColor="{StaticResource SunYellowLight}" StrokeShape="RoundRectangle 25" HeightRequest="50" WidthRequest="50" Padding="12">
                                     <Path Data="{StaticResource IconGlobe}" Fill="{StaticResource SoilBrown}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Action" Style="{StaticResource BodyBold}" 
                                       VerticalOptions="Center" 
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource EcoGreenDark}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Solutions -->
                        <Border Style="{StaticResource AppCard}" WidthRequest="130" HeightRequest="150" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" Padding="16">
                             <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                                 <Border BackgroundColor="{StaticResource Gray100}" StrokeShape="RoundRectangle 25" HeightRequest="50" WidthRequest="50" Padding="12">
                                     <Path Data="{StaticResource IconBulb}" Fill="{StaticResource Gray600}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Solutions" Style="{StaticResource BodyBold}" 
                                       VerticalOptions="Center" 
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray600}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>
                

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource AppCard}" Grid.Column="0">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{x:Static resx:Strings.HomeTeacherCornerTitle}" Style="{StaticResource CardTitle}" FontSize="16" />
                                <Path Data="{StaticResource IconBook}" Fill="{StaticResource EcoGreen}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" Grid.Column="1"/>
                            </Grid>
                            <Label Text="Access resources." Style="{StaticResource BodySmall}" LineBreakMode="TailTruncation" />
                            <Button Text="Resources"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="12"
                                    HeightRequest="40"
                                    Padding="0"
                                    Command="{Binding TeacherResourcesCommand}" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <Border Style="{StaticResource AppCard}" Grid.Column="1">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{x:Static resx:Strings.ActivityTitle}" Style="{StaticResource CardTitle}" FontSize="16" />
                                <Path Data="{StaticResource IconPuzzle}" Fill="{StaticResource SunYellow}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" Grid.Column="1"/>
                            </Grid>
                            <Label Text="Try a quick quiz." Style="{StaticResource BodySmall}" LineBreakMode="TailTruncation" />
                            <Button Text="Start"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="12"
                                    HeightRequest="40"
                                    Padding="0"
                                    Command="{Binding ActivityCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Button Text="{Binding SecondaryActionText}"
                    Background="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource TextColorMuted}, Dark={StaticResource TextColorMutedDark}}"
                        FontSize="14"
                        SemanticProperties.Hint="{x:Static resx:Strings.HintOpenGlossary}"
                        Command="{Binding SecondaryActionCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
