<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EcoWay.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EcoWay.Views"
    FlyoutBehavior="Disabled"
    Title="EcoRoot">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage" />

        <ShellContent
            Title="Causes"
            ContentTemplate="{DataTemplate views:CausesPage}"
            Route="CausesPage" />

        <ShellContent
            Title="Impact"
            ContentTemplate="{DataTemplate views:ConsequencesPage}"
            Route="ConsequencesPage" />

        <ShellContent
            Title="Solutions"
            ContentTemplate="{DataTemplate views:SolutionsPage}"
            Route="SolutionsPage" />

        <ShellContent
            Title="Act"
            ContentTemplate="{DataTemplate views:ActionPlanPage}"
            Route="ActionPlanPage" />
    </TabBar>

</Shell>
