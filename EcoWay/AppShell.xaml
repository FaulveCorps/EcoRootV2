<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EcoWay.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EcoWay.Views"
    Title="EcoWay">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:MainMenuPage}"
            Route="MainMenuPage" />

        <ShellContent
            Title="Story"
            ContentTemplate="{DataTemplate views:ScenarioPage}"
            Route="ScenarioPage" />

        <ShellContent
            Title="Impact Lab"
            ContentTemplate="{DataTemplate views:ImpactLabPage}"
            Route="ImpactLabPage" />
    </TabBar>

</Shell>
