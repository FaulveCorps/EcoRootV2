<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcoWay.Views.SummaryPage"
             x:DataType="viewmodels:SummaryViewModel"
             Shell.NavBarIsVisible="False"
             Title="Summary">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource ModernPageGradientTopLight}, Dark={StaticResource ModernPageGradientTopDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource ModernPageGradientBottomLight}, Dark={StaticResource ModernPageGradientBottomDark}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="16,22,16,30" Spacing="12">

                <Border Style="{StaticResource AndroidAppBarCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Run Outcome"
                                   Style="{StaticResource AndroidSectionTitle}" />
                            <Border Style="{StaticResource AndroidChip}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentPrimaryLight}, Dark={StaticResource ModernAccentPrimaryDark}}">
                                <Label Text="Complete"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11"
                                       TextColor="#ECFFF6" />
                            </Border>
                        </Grid>

                        <HorizontalStackLayout Spacing="6"
                                               BindableLayout.ItemsSource="{Binding AchievementTags}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AndroidChip}">
                                        <Label Text="{Binding .}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Journey Complete"
                               Style="{StaticResource ModernHeroTitle}" />
                        <Label Text="Your decisions shaped this ecosystem narrative arc."
                               Style="{StaticResource ModernBodyMuted}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource AndroidCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Final Score" Style="{StaticResource ModernBodyMuted}" />
                            <Label Text="{Binding TotalScore, StringFormat='{}{0} pts'}"
                                   Style="{StaticResource ModernStatValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AndroidCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Ending" Style="{StaticResource ModernBodyMuted}" />
                            <Label Text="{Binding Ending.Title}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource ModernTextHeadlineLight}, Dark={StaticResource ModernTextHeadlineDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Ending.Title}"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light={StaticResource ModernTextHeadlineLight}, Dark={StaticResource ModernTextHeadlineDark}}" />
                        <Label Text="{Binding Ending.Description}"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Play Again"
                        Command="{Binding RestartCommand}"
                        Style="{StaticResource AndroidFabButton}">
                    <Button.Behaviors>
                        <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.86" />
                    </Button.Behaviors>
                </Button>

                <Border Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Quick Actions"
                               Style="{StaticResource AndroidSectionTitle}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Mission Hub"
                                    Style="{StaticResource AndroidFabButton}"
                                    Clicked="OnGoHomeClicked"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentSecondaryLight}, Dark={StaticResource ModernAccentSecondaryDark}}">
                                <Button.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.86" />
                                </Button.Behaviors>
                            </Button>

                            <Button Grid.Column="1"
                                    Text="Impact Lab"
                                    Style="{StaticResource AndroidFabButton}"
                                    Clicked="OnGoImpactLabClicked"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentWarningLight}, Dark={StaticResource ModernAccentWarningDark}}">
                                <Button.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.86" />
                                </Button.Behaviors>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
