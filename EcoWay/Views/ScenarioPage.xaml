<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EcoWay.Models"
             x:Class="EcoWay.Views.ScenarioPage"
             x:Name="ScenarioPageRoot"
             Shell.NavBarIsVisible="False"
             Title="Eco Way">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource EcoPageGradientTopLight}, Dark={StaticResource EcoPageGradientTopDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource EcoPageGradientBottomLight}, Dark={StaticResource EcoPageGradientBottomDark}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="14,14,14,28" Spacing="12">
                <Border StrokeThickness="0"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfacePrimaryLight}, Dark={StaticResource EcoSurfacePrimaryDark}}"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding CurrentScenario.Title}"
                               FontSize="28"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#123827, Dark=#D2FFE9}" />
                        <Label Text="{Binding CurrentScenario.Description}"
                               FontSize="15"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#355A4C, Dark=#A8D8C2}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfaceSecondaryLight}, Dark={StaticResource EcoSurfaceSecondaryDark}}"
                        StrokeShape="RoundRectangle 18">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10">
                        <Label Text="{Binding SceneMoodText}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#3A6554, Dark=#9FD0BA}" />
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                Padding="4"
                                MinimumHeightRequest="32"
                            BackgroundColor="{AppThemeBinding Light={StaticResource EcoAccentPrimaryLight}, Dark={StaticResource EcoAccentPrimaryDark}}"
                                StrokeShape="RoundRectangle 999">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                <Border StrokeThickness="0"
                                        Padding="8,3"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 999">
                                    <Label Text="Phase"
                                           FontSize="11"
                                           MaxLines="1"
                                           LineBreakMode="NoWrap"
                                           VerticalTextAlignment="Center"
                                           TextColor="#E8FFF4" />
                                </Border>

                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        Padding="10,3"
                                        BackgroundColor="{AppThemeBinding Light=#3D9D77, Dark=#3A7F65}"
                                        StrokeShape="RoundRectangle 999">
                                    <Label Text="{Binding StageBadgeText}"
                                           FontSize="11"
                                         FontFamily="OpenSansSemibold"
                                           MaxLines="1"
                                           LineBreakMode="NoWrap"
                                           VerticalTextAlignment="Center"
                                           TextColor="#E8FFF4" />
                                </Border>
                            </Grid>
                        </Border>

                        <ProgressBar x:Name="ScenarioProgressBar"
                                     Grid.Row="1"
                                     Progress="{Binding ProgressValue}"
                                     HeightRequest="8"
                                     ProgressColor="{AppThemeBinding Light=#2D8C66, Dark=#6AD9A7}"
                                     BackgroundColor="{AppThemeBinding Light=#D5EBDD, Dark=#3B5A4D}" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding ProgressText}"
                               FontSize="11"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#4D7464, Dark=#9ECFBA}" />
                    </Grid>
                </Border>

                <Border StrokeThickness="0"
                        HeightRequest="260"
                        StrokeShape="RoundRectangle 24">
                    <Grid IsClippedToBounds="True">
                        <Border x:Name="SkyPanel" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="SkyGradientTop" Color="#8AD7FF" Offset="0.0" />
                                    <GradientStop x:Name="SkyGradientBottom" Color="#F0FCFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <AbsoluteLayout x:Name="SceneLayout" Margin="10">
                            <BoxView x:Name="Sun"
                                     Color="#FFD966"
                                     WidthRequest="64"
                                     HeightRequest="64"
                                     CornerRadius="32"
                                     AbsoluteLayout.LayoutBounds="0.14,0.12,64,64"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <Border x:Name="CloudA"
                                    BackgroundColor="#E9F7FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="92"
                                    HeightRequest="34"
                                    AbsoluteLayout.LayoutBounds="0.34,0.16,92,34"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <Border x:Name="CloudB"
                                    BackgroundColor="#DDF2FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="82"
                                    HeightRequest="30"
                                    AbsoluteLayout.LayoutBounds="0.67,0.21,82,30"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                                <BoxView x:Name="HorizonLine"
                                     Color="#7EA0BA"
                                     Opacity="0.45"
                                     AbsoluteLayout.LayoutBounds="0.5,0.52,0.95,0.01"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="CityLine"
                                     Color="#6B7D8F"
                                     Opacity="0.85"
                                     AbsoluteLayout.LayoutBounds="0.5,0.60,0.86,0.23"
                                     AbsoluteLayout.LayoutFlags="All" />

                                <BoxView x:Name="FactoryStack"
                                     Color="#72889B"
                                     Opacity="0.95"
                                     AbsoluteLayout.LayoutBounds="0.72,0.47,0.16,0.12"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="Road"
                                     Color="#4D5965"
                                     AbsoluteLayout.LayoutBounds="0.5,0.74,0.96,0.12"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="Vehicle"
                                     Color="#F4A261"
                                     WidthRequest="52"
                                     HeightRequest="18"
                                     CornerRadius="9"
                                     AbsoluteLayout.LayoutBounds="0.18,0.71,52,18"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="Ground"
                                     Color="#5FA35A"
                                     AbsoluteLayout.LayoutBounds="0.5,0.88,1.02,0.28"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="TreeLeftTrunk"
                                     Color="#6F4E37"
                                     WidthRequest="11"
                                     HeightRequest="42"
                                     AbsoluteLayout.LayoutBounds="0.16,0.74,11,42"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="TreeLeftCrown"
                                     Color="#2E8B57"
                                     WidthRequest="38"
                                     HeightRequest="38"
                                     CornerRadius="19"
                                     AbsoluteLayout.LayoutBounds="0.15,0.64,38,38"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="TreeRightTrunk"
                                     Color="#6F4E37"
                                     WidthRequest="11"
                                     HeightRequest="42"
                                     AbsoluteLayout.LayoutBounds="0.83,0.74,11,42"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="TreeRightCrown"
                                     Color="#3C9A5F"
                                     WidthRequest="38"
                                     HeightRequest="38"
                                     CornerRadius="19"
                                     AbsoluteLayout.LayoutBounds="0.82,0.64,38,38"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="WaterLevel"
                                     Color="#4CA7E8"
                                     Opacity="0.15"
                                     AbsoluteLayout.LayoutBounds="0.5,0.86,0.46,0.13"
                                     AbsoluteLayout.LayoutFlags="All" />

                                <Border x:Name="RippleRingA"
                                    Stroke="#D7F2FF"
                                    StrokeThickness="2"
                                    BackgroundColor="Transparent"
                                    Opacity="0"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    StrokeShape="RoundRectangle 17"
                                    AbsoluteLayout.LayoutBounds="0.50,0.83,34,34"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                                <Border x:Name="RippleRingB"
                                    Stroke="#C5E8FF"
                                    StrokeThickness="2"
                                    BackgroundColor="Transparent"
                                    Opacity="0"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    StrokeShape="RoundRectangle 17"
                                    AbsoluteLayout.LayoutBounds="0.59,0.84,34,34"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="SmokePlume"
                                     Color="#8C9AA7"
                                     Opacity="0.2"
                                     CornerRadius="12"
                                     WidthRequest="56"
                                     HeightRequest="24"
                                     AbsoluteLayout.LayoutBounds="0.75,0.41,56,24"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />
                        </AbsoluteLayout>
                    </Grid>
                </Border>

                <Border x:Name="EffectsCard"
                    StrokeThickness="0"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfacePrimaryLight}, Dark={StaticResource EcoSurfacePrimaryDark}}"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Active Effects"
                               FontSize="13"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#2E5E4B, Dark=#A7E2C7}" />

                        <Label Text="{Binding NoEffectsText}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#557B6C, Dark=#8FCAB0}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActiveEffects}" Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Text="✦"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#2D8C66, Dark=#6AD9A7}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding .}"
                                               FontSize="12"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light=#43695A, Dark=#94CEB4}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Choices}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Choice">
                            <Border StrokeThickness="0"
                                    Padding="14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfaceSecondaryLight}, Dark={StaticResource EcoSurfaceSecondaryDark}}"
                                    StrokeShape="RoundRectangle 18">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                    <Label Grid.RowSpan="2"
                                           Text="{Binding Icon}"
                                           FontSize="22"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding Text}"
                                           FontSize="15"
                                         FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#153C2B, Dark=#D6FFE9}" />

                                    <Label Grid.Column="1"
                                           Grid.Row="1"
                                           Text="{Binding Teaser}"
                                           IsVisible="{Binding HasTeaser}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#3D6656, Dark=#9FD7BD}" />

                                    <Border Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Padding="8,5"
                                            VerticalOptions="Center"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource EcoAccentPrimaryLight}, Dark={StaticResource EcoAccentPrimaryDark}}"
                                            StrokeShape="RoundRectangle 999">
                                        <Label Text="Choose"
                                               FontSize="11"
                                               TextColor="#E6FFF3" />
                                    </Border>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChoiceTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>