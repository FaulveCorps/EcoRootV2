<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EcoWay.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcoWay.Views.ScenarioPage"
             x:Name="ScenarioPageRoot"
             Shell.NavBarIsVisible="False"
             Title="Eco Way">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource ModernPageGradientTopLight}, Dark={StaticResource ModernPageGradientTopDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource ModernPageGradientBottomLight}, Dark={StaticResource ModernPageGradientBottomDark}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="14,14,14,28" Spacing="12">
                <Border Style="{StaticResource AndroidAppBarCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Story Experience"
                                   Style="{StaticResource AndroidSectionTitle}" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource AndroidChip}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentPrimaryLight}, Dark={StaticResource ModernAccentPrimaryDark}}">
                                <Label Text="{Binding StageBadgeText}"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="#ECFFF6" />
                            </Border>
                        </Grid>

                        <HorizontalStackLayout Spacing="6">
                            <Border Style="{StaticResource AndroidChip}">
                                <Label Text="Live Simulation"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />
                            </Border>
                            <Border Style="{StaticResource AndroidChip}">
                                <Label Text="Branching Paths"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />
                            </Border>
                            <Border Style="{StaticResource AndroidChip}">
                                <Label Text="Adaptive Mood"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding CurrentScenario.Title}"
                               FontSize="28"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource ModernTextHeadlineLight}, Dark={StaticResource ModernTextHeadlineDark}}" />
                        <Label Text="{Binding CurrentScenario.Description}"
                               FontSize="15"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AndroidCard}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10">
                        <Label Text="{Binding SceneMoodText}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="4"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center">
                            <Border Style="{StaticResource AndroidChip}"
                                    Padding="9,4"
                                    BackgroundColor="{AppThemeBinding Light=#2F7F62, Dark=#2B6D56}">
                                <Label Text="Phase"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       MaxLines="1"
                                       LineBreakMode="NoWrap"
                                       VerticalTextAlignment="Center"
                                       TextColor="#E9FFF5" />
                            </Border>

                            <Border Style="{StaticResource AndroidChip}"
                                    Padding="10,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentPrimaryLight}, Dark={StaticResource ModernAccentPrimaryDark}}">
                                <Label Text="{Binding StageBadgeText}"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       MaxLines="1"
                                       LineBreakMode="NoWrap"
                                       VerticalTextAlignment="Center"
                                       TextColor="#E9FFF5" />
                            </Border>
                        </HorizontalStackLayout>

                        <ProgressBar x:Name="ScenarioProgressBar"
                                     Grid.Row="1"
                                     Progress="{Binding ProgressValue}"
                                     HeightRequest="8"
                                     ProgressColor="{AppThemeBinding Light={StaticResource ModernAccentPrimaryLight}, Dark={StaticResource ModernAccentPrimaryDark}}"
                                     BackgroundColor="{AppThemeBinding Light=#D5EBDD, Dark=#3B5A4D}" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding ProgressText}"
                               FontSize="11"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#4D7464, Dark=#9ECFBA}" />
                    </Grid>
                </Border>

                <Border StrokeThickness="0"
                        HeightRequest="260"
                        StrokeShape="RoundRectangle 24">
                    <Grid IsClippedToBounds="True">
                        <Border x:Name="SkyPanel" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="SkyGradientTop" Color="#8AD7FF" Offset="0.0" />
                                    <GradientStop x:Name="SkyGradientBottom" Color="#F0FCFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <AbsoluteLayout x:Name="SceneLayout" Margin="10">
                            <BoxView x:Name="Sun"
                                     Color="#FFD966"
                                     WidthRequest="64"
                                     HeightRequest="64"
                                     CornerRadius="32"
                                     AbsoluteLayout.LayoutBounds="0.14,0.12,64,64"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <Border x:Name="CloudA"
                                    BackgroundColor="#E9F7FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="92"
                                    HeightRequest="34"
                                    AbsoluteLayout.LayoutBounds="0.34,0.16,92,34"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <Border x:Name="CloudB"
                                    BackgroundColor="#DDF2FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="82"
                                    HeightRequest="30"
                                    AbsoluteLayout.LayoutBounds="0.67,0.21,82,30"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                                <BoxView x:Name="HorizonLine"
                                     Color="#7EA0BA"
                                     Opacity="0.45"
                                     AbsoluteLayout.LayoutBounds="0.5,0.52,0.95,0.01"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="CityLine"
                                     Color="#6B7D8F"
                                     Opacity="0.85"
                                     AbsoluteLayout.LayoutBounds="0.5,0.60,0.86,0.23"
                                     AbsoluteLayout.LayoutFlags="All" />

                                <BoxView x:Name="FactoryStack"
                                     Color="#72889B"
                                     Opacity="0.95"
                                     AbsoluteLayout.LayoutBounds="0.72,0.47,0.16,0.12"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="Road"
                                     Color="#4D5965"
                                     AbsoluteLayout.LayoutBounds="0.5,0.74,0.96,0.12"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="Vehicle"
                                     Color="#F4A261"
                                     WidthRequest="52"
                                     HeightRequest="18"
                                     CornerRadius="9"
                                     AbsoluteLayout.LayoutBounds="0.18,0.71,52,18"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="Ground"
                                     Color="#5FA35A"
                                     AbsoluteLayout.LayoutBounds="0.5,0.88,1.02,0.28"
                                     AbsoluteLayout.LayoutFlags="All" />

                            <BoxView x:Name="TreeLeftTrunk"
                                     Color="#6F4E37"
                                     WidthRequest="11"
                                     HeightRequest="42"
                                     AbsoluteLayout.LayoutBounds="0.16,0.74,11,42"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="TreeLeftCrown"
                                     Color="#2E8B57"
                                     WidthRequest="38"
                                     HeightRequest="38"
                                     CornerRadius="19"
                                     AbsoluteLayout.LayoutBounds="0.15,0.64,38,38"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="TreeRightTrunk"
                                     Color="#6F4E37"
                                     WidthRequest="11"
                                     HeightRequest="42"
                                     AbsoluteLayout.LayoutBounds="0.83,0.74,11,42"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="TreeRightCrown"
                                     Color="#3C9A5F"
                                     WidthRequest="38"
                                     HeightRequest="38"
                                     CornerRadius="19"
                                     AbsoluteLayout.LayoutBounds="0.82,0.64,38,38"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="WaterLevel"
                                     Color="#4CA7E8"
                                     Opacity="0.15"
                                     AbsoluteLayout.LayoutBounds="0.5,0.86,0.46,0.13"
                                     AbsoluteLayout.LayoutFlags="All" />

                                <Border x:Name="RippleRingA"
                                    Stroke="#D7F2FF"
                                    StrokeThickness="2"
                                    BackgroundColor="Transparent"
                                    Opacity="0"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    StrokeShape="RoundRectangle 17"
                                    AbsoluteLayout.LayoutBounds="0.50,0.83,34,34"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                                <Border x:Name="RippleRingB"
                                    Stroke="#C5E8FF"
                                    StrokeThickness="2"
                                    BackgroundColor="Transparent"
                                    Opacity="0"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    StrokeShape="RoundRectangle 17"
                                    AbsoluteLayout.LayoutBounds="0.59,0.84,34,34"
                                    AbsoluteLayout.LayoutFlags="PositionProportional" />

                            <BoxView x:Name="SmokePlume"
                                     Color="#8C9AA7"
                                     Opacity="0.2"
                                     CornerRadius="12"
                                     WidthRequest="56"
                                     HeightRequest="24"
                                     AbsoluteLayout.LayoutBounds="0.75,0.41,56,24"
                                     AbsoluteLayout.LayoutFlags="PositionProportional" />
                        </AbsoluteLayout>
                    </Grid>
                </Border>

                <Border x:Name="EffectsCard"
                        Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Active Effects"
                               FontSize="13"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource ModernTextHeadlineLight}, Dark={StaticResource ModernTextHeadlineDark}}" />

                        <Label Text="{Binding NoEffectsText}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActiveEffects}" Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Text="✦"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#2D8C66, Dark=#6AD9A7}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding .}"
                                               FontSize="12"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light=#43695A, Dark=#94CEB4}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Choices}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Choice">
                            <Border StrokeThickness="0"
                                    Padding="14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernSurfaceCardLight}, Dark={StaticResource ModernSurfaceCardDark}}"
                                    StrokeShape="RoundRectangle 18">
                                <Border.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.975" PressedOpacity="0.9" />
                                </Border.Behaviors>
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                    <Label Grid.RowSpan="2"
                                           Text="{Binding Icon}"
                                           FontSize="22"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding Text}"
                                           FontSize="15"
                                         FontFamily="OpenSansSemibold"
                                                                                     TextColor="{AppThemeBinding Light={StaticResource ModernTextHeadlineLight}, Dark={StaticResource ModernTextHeadlineDark}}" />

                                    <Label Grid.Column="1"
                                           Grid.Row="1"
                                           Text="{Binding Teaser}"
                                           IsVisible="{Binding HasTeaser}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource ModernTextBodyLight}, Dark={StaticResource ModernTextBodyDark}}" />

                                    <Border Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Padding="8,5"
                                            VerticalOptions="Center"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentPrimaryLight}, Dark={StaticResource ModernAccentPrimaryDark}}"
                                            StrokeShape="RoundRectangle 999">
                                        <Label Text="Choose"
                                               FontSize="11"
                                               TextColor="#E6FFF3" />
                                    </Border>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChoiceTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Quick Actions"
                               Style="{StaticResource AndroidSectionTitle}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Mission Hub"
                                    Style="{StaticResource AndroidFabButton}"
                                    Clicked="OnGoHomeClicked"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentSecondaryLight}, Dark={StaticResource ModernAccentSecondaryDark}}">
                                <Button.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.85" />
                                </Button.Behaviors>
                            </Button>
                            <Button Grid.Column="1"
                                    Text="Impact Lab"
                                    Style="{StaticResource AndroidFabButton}"
                                    Clicked="OnGoImpactLabClicked"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentWarningLight}, Dark={StaticResource ModernAccentWarningDark}}">
                                <Button.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.85" />
                                </Button.Behaviors>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>