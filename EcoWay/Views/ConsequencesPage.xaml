<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             xmlns:models="clr-namespace:EcoWay.Models"
             x:Class="EcoWay.Views.ConsequencesPage"
             x:Name="ConsequencesPageRoot"
             x:DataType="viewmodels:ConsequencesViewModel"
             Title="Impact">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="The Ripple Effect"
                   FontSize="26"
                   FontFamily="OpenSansSemibold"
                   TextColor="#1B2F25" />
            <Label Text="Select an ecosystem node to see how soil pollution spreads through connected systems."
                   FontSize="13"
                   TextColor="#4A6A5B" />

            <CollectionView ItemsSource="{Binding Impacts}" SelectionMode="None" HeightRequest="112">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConsequenceItem">
                        <Border StrokeThickness="0"
                                BackgroundColor="#F2F8F4"
                                StrokeShape="RoundRectangle 14"
                                Padding="10"
                                WidthRequest="120">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Icon}"
                                       FontSize="24"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Title}"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       TextColor="#2C4D3F" />
                                <Button Text="View"
                                        FontSize="10"
                                        CornerRadius="999"
                                        Padding="10,2"
                                        BackgroundColor="#3E7CA8"
                                        TextColor="White"
                                        Command="{Binding BindingContext.SelectImpactCommand, Source={x:Reference ConsequencesPageRoot}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border StrokeThickness="0"
                    BackgroundColor="#F9FCFA"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SelectedIcon}"
                           FontSize="30" />
                    <Label Text="{Binding SelectedTitle}"
                           FontSize="18"
                           FontFamily="OpenSansSemibold"
                           TextColor="#244437" />
                    <Label Text="{Binding SelectedSummary}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="#4B6B5D" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedKeyPoints}" Spacing="5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding ., StringFormat='• {0}'}"
                                       FontSize="12"
                                       TextColor="#3D5E50" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
