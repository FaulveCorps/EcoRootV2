<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             x:Class="EcoWay.Views.MainMenuPage"
             x:DataType="viewmodels:MainMenuViewModel"
             Shell.NavBarIsVisible="False"
             Title="Mission Hub">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource EcoPageGradientTopLight}, Dark={StaticResource EcoPageGradientTopDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource EcoPageGradientBottomLight}, Dark={StaticResource EcoPageGradientBottomDark}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="16,20,16,28" Spacing="12">
                <Border StrokeThickness="0"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfacePrimaryLight}, Dark={StaticResource EcoSurfacePrimaryDark}}"
                        StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🎮 ECO WAY"
                               FontSize="30"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#134232, Dark=#D6FFEA}" />
                        <Label Text="Mission Hub"
                               FontSize="15"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#2D6552, Dark=#9FD4BD}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding PlayerRankText}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#3A6658, Dark=#A5D8C2}" />
                            <Border Grid.Column="1"
                                    Padding="8,4"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource EcoAccentPrimaryLight}, Dark={StaticResource EcoAccentPrimaryDark}}"
                                    StrokeShape="RoundRectangle 999">
                                <Label Text="{Binding RunStateText}"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="#E9FFF5" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border StrokeThickness="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfaceSecondaryLight}, Dark={StaticResource EcoSurfaceSecondaryDark}}" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Eco Score" FontSize="11" TextColor="{AppThemeBinding Light=#507467, Dark=#96CBB3}" />
                            <Label Text="{Binding TotalScoreText}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light=#1E4F3D, Dark=#C4F9DE}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" StrokeThickness="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfaceSecondaryLight}, Dark={StaticResource EcoSurfaceSecondaryDark}}" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Decisions" FontSize="11" TextColor="{AppThemeBinding Light=#507467, Dark=#96CBB3}" />
                            <Label Text="{Binding DecisionsCountText}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light=#1E4F3D, Dark=#C4F9DE}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" StrokeThickness="0" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfaceSecondaryLight}, Dark={StaticResource EcoSurfaceSecondaryDark}}" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Checkpoint" FontSize="11" TextColor="{AppThemeBinding Light=#507467, Dark=#96CBB3}" />
                            <Label Text="{Binding LastCheckpointText}" FontSize="15" FontFamily="OpenSansSemibold" MaxLines="1" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#1E4F3D, Dark=#C4F9DE}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border StrokeThickness="0"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfaceSecondaryLight}, Dark={StaticResource EcoSurfaceSecondaryDark}}"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌍 Story Campaign"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#1C4A39, Dark=#C2F5DC}" />
                        <Label Text="{Binding PrimaryActionHint}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#496E60, Dark=#9CCFB9}" />
                        <Button Text="{Binding PrimaryActionText}"
                                Command="{Binding PrimaryActionCommand}"
                                FontFamily="OpenSansSemibold"
                                BackgroundColor="{AppThemeBinding Light={StaticResource EcoAccentPrimaryLight}, Dark={StaticResource EcoAccentPrimaryDark}}"
                                TextColor="#ECFFF6" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EcoSurfaceTertiaryLight}, Dark={StaticResource EcoSurfaceTertiaryDark}}"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🧪 Challenge Modes"
                               FontSize="14"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#244E66, Dark=#BBDCF0}" />
                        <Button Text="Launch Impact Lab"
                                Command="{Binding OpenImpactLabCommand}"
                                FontFamily="OpenSansSemibold"
                                BackgroundColor="{AppThemeBinding Light=#2D6E8A, Dark=#355F7B}"
                                TextColor="#ECF8FF" />
                        <Button Text="{Binding SummaryActionText}"
                                Command="{Binding ViewSummaryCommand}"
                                IsEnabled="{Binding CanViewSummary}"
                                FontFamily="OpenSansSemibold"
                                BackgroundColor="{AppThemeBinding Light=#5B6F80, Dark=#4D6172}"
                                TextColor="#EEF8FF" />
                        <Label Text="{Binding SummaryHintText}"
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#5F7280, Dark=#A8BECF}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>