<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EcoWay.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EcoWay.Views.MainMenuPage"
             x:DataType="viewmodels:MainMenuViewModel"
             Shell.NavBarIsVisible="False"
             Title="Mission Hub">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource ModernPageGradientTopLight}, Dark={StaticResource ModernPageGradientTopDark}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource ModernPageGradientBottomLight}, Dark={StaticResource ModernPageGradientBottomDark}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="16,20,16,28" Spacing="12">

                <Border Style="{StaticResource AndroidAppBarCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="EcoWay Command Center"
                               Style="{StaticResource ModernHeroTitle}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding PlayerRankText}"
                                   Style="{StaticResource ModernBodyMuted}" />
                            <Border Style="{StaticResource AndroidChip}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentPrimaryLight}, Dark={StaticResource ModernAccentPrimaryDark}}">
                                <Label Text="{Binding RunStateText}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11"
                                       TextColor="#EDFFF7" />
                            </Border>
                        </Grid>

                        <Label Text="Choose a mode and shape your ecosystem outcomes with polished, real-time feedback."
                               Style="{StaticResource ModernBodyMuted}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Style="{StaticResource AndroidCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Eco Score" Style="{StaticResource ModernBodyMuted}" />
                            <Label Text="{Binding TotalScoreText}" Style="{StaticResource ModernStatValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AndroidCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Decisions" Style="{StaticResource ModernBodyMuted}" />
                            <Label Text="{Binding DecisionsCountText}" Style="{StaticResource ModernStatValue}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AndroidCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Checkpoint" Style="{StaticResource ModernBodyMuted}" />
                            <Label Text="{Binding LastCheckpointText}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource ModernTextHeadlineLight}, Dark={StaticResource ModernTextHeadlineDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AndroidCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Daily Quest" Style="{StaticResource ModernBodyMuted}" />
                            <Label Text="{Binding DailyQuestProgressText}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource ModernTextHeadlineLight}, Dark={StaticResource ModernTextHeadlineDark}}" />
                            <ProgressBar Progress="{Binding DailyQuestProgress}"
                                         HeightRequest="7"
                                         ProgressColor="{AppThemeBinding Light={StaticResource ModernAccentPrimaryLight}, Dark={StaticResource ModernAccentPrimaryDark}}"
                                         BackgroundColor="{AppThemeBinding Light=#D8ECE2, Dark=#3A5A4B}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Story Campaign"
                               Style="{StaticResource AndroidSectionTitle}" />

                        <Label Text="{Binding PrimaryActionHint}" Style="{StaticResource ModernBodyMuted}" />

                        <Button Text="{Binding PrimaryActionText}"
                                Command="{Binding PrimaryActionCommand}"
                                Clicked="OnPrimaryActionClicked"
                                Style="{StaticResource AndroidFabButton}">
                            <Button.Behaviors>
                                <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.86" />
                            </Button.Behaviors>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AndroidCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Challenge Modes"
                               Style="{StaticResource AndroidSectionTitle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Launch Impact Lab"
                                    Command="{Binding OpenImpactLabCommand}"
                                    Clicked="OnOpenImpactLabClicked"
                                    Style="{StaticResource AndroidFabButton}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentSecondaryLight}, Dark={StaticResource ModernAccentSecondaryDark}}">
                                <Button.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.86" />
                                </Button.Behaviors>
                            </Button>

                            <Button Grid.Column="1"
                                    Text="{Binding SummaryActionText}"
                                    Command="{Binding ViewSummaryCommand}"
                                    Clicked="OnOpenSummaryClicked"
                                    Style="{StaticResource AndroidFabButton}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ModernAccentWarningLight}, Dark={StaticResource ModernAccentWarningDark}}">
                                <Button.Behaviors>
                                    <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.86" />
                                </Button.Behaviors>
                            </Button>
                        </Grid>

                        <Label Text="{Binding SummaryHintText}" Style="{StaticResource ModernBodyMuted}" />

                        <Button Text="Reset Run"
                                Command="{Binding ResetRunCommand}"
                                Clicked="OnResetRunClicked"
                                Style="{StaticResource AndroidFabButton}"
                                BackgroundColor="{AppThemeBinding Light=#4A6778, Dark=#3F596A}">
                            <Button.Behaviors>
                                <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.86" />
                            </Button.Behaviors>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
